// VeeJam Limited ERP — database schema
//
// Conventions (see docs/DATABASE_SCHEMA.md):
// - UUID primary keys generated by Postgres, except singletons and logs.
// - Money: Decimal(18,2). Never Float.
// - Timestamps: timestamptz, stored in UTC.
// - Table names snake_case via @@map; Prisma model names PascalCase.
// - Every table has row-level security enabled with no policies, so the
//   Supabase Data API (anon/authenticated keys) cannot read or write it.
//   The app connects as the database owner through Prisma.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ─── Users and roles ──────────────────────────────────────────────

/// Roles are fixed; what each role may do is defined in src/server/auth/permissions.ts.
enum UserRole {
  OWNER
  ADMIN
  ACCOUNTANT
  SALES
  STOREKEEPER
}

/// An ERP user. Sign-in credentials live in Supabase Auth; this row links the
/// Supabase account to a role and lets the app deactivate access instantly.
model User {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authUserId     String    @unique @map("auth_user_id") @db.Uuid
  email          String    @unique
  fullName       String    @map("full_name")
  phone          String?
  /// Linked WhatsApp number (digits, e.g. 254712345678). Only owners can run commands from it.
  whatsappNumber String?   @unique @map("whatsapp_number")
  role           UserRole
  isActive       Boolean   @default(true) @map("is_active")
  deactivatedAt  DateTime? @map("deactivated_at") @db.Timestamptz(3)
  lastSeenAt     DateTime? @map("last_seen_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  dutyChanges           UserDutyChange[]
  auditEntries          AuditLog[]
  settingsUpdates       CompanySettings[]
  legacyImportBatches   LegacyImportBatch[]
  priceUpdates          PriceListItem[]
  customersCreated      Customer[]
  stockMovements        StockMovement[]
  stockAdjustments      StockAdjustment[]
  stockTransfers        StockTransfer[]
  stockCountsCreated    StockCount[]           @relation("StockCountCreatedBy")
  stockCountsPosted     StockCount[]           @relation("StockCountPostedBy")
  importJobsCreated     ImportJob[]            @relation("ImportJobCreatedBy")
  importJobsCommitted   ImportJob[]            @relation("ImportJobCommittedBy")
  salesDocumentsCreated SalesDocument[]        @relation("SalesDocumentCreatedBy")
  salesDocumentsPosted  SalesDocument[]        @relation("SalesDocumentPostedBy")
  creditOverrides       SalesDocument[]        @relation("SalesDocumentCreditOverrideBy")
  deliveryNotes         DeliveryNote[]
  shareLinks            DocumentShareLink[]
  taxRateUpdates        TaxRate[]
  journalEntries        JournalEntry[]
  paymentsReceived      Payment[]              @relation("PaymentReceivedBy")
  paymentsReversed      Payment[]              @relation("PaymentReversedBy")
  allocationsMade       PaymentAllocation[]
  whatsappMessages      WhatsAppMessage[]
  whatsappConfirmations WhatsAppConfirmation[]
  purchaseOrdersCreated PurchaseOrder[]
  goodsReceiptsPosted   GoodsReceipt[]
  billsPosted           SupplierBill[]         @relation("SupplierBillPostedBy")
  billsCancelled        SupplierBill[]         @relation("SupplierBillCancelledBy")
  supplierPaymentsMade  SupplierPayment[]      @relation("SupplierPaymentPaidBy")
  supplierPaymentsRev   SupplierPayment[]      @relation("SupplierPaymentReversedBy")
  stockRevaluations     StockRevaluation[]

  @@map("users")
}

/// A duty an owner or admin switched on or off for one person, on top of their role's defaults.
/// Owners ignore these (they always hold every duty). Cleared when the person's role changes.
model UserDutyChange {
  userId     String   @map("user_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// A permission key, e.g. "payments.reverse".
  permission String
  /// true = switched on although the role doesn't include it; false = switched off.
  granted    Boolean
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([userId, permission])
  @@map("user_duty_changes")
}

// ─── Company settings ─────────────────────────────────────────────

/// Single row (id = 1, enforced by a CHECK constraint). Edited on the Settings page.
model CompanySettings {
  id                      Int        @id @default(1)
  name                    String
  telephone               String
  documentEmail           String     @map("document_email")
  country                 String
  currency                String     @db.Char(3)
  timezone                String
  businessType            String     @map("business_type")
  productScope            String     @map("product_scope")
  kraPin                  String?    @map("kra_pin")
  physicalAddress         String?    @map("physical_address")
  postalAddress           String?    @map("postal_address")
  paymentInstructions     String?    @map("payment_instructions")
  invoiceTerms            String?    @map("invoice_terms")
  defaultPaymentTermsDays Int        @default(0) @map("default_payment_terms_days")
  /// Line under the company name on documents, e.g. "Wrigley Product Distribution - Kenya".
  tagline                 String?
  /// Printed in the payment box on invoices.
  mpesaPaybill            String?    @map("mpesa_paybill")
  mpesaAccount            String?    @map("mpesa_account")
  vatRegistered           Boolean    @default(false) @map("vat_registered")
  /// No journal entry, payment or credit note can be dated on or before this day.
  booksClosedUntil        DateTime?  @map("books_closed_until") @db.Date
  /// Optimistic locking: incremented on every save, so two people editing at once can't overwrite each other.
  version                 Int        @default(1)
  updatedAt               DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById             String?    @map("updated_by_id") @db.Uuid
  updatedBy               User?      @relation(fields: [updatedById], references: [id], onDelete: Restrict)
  /// Price list used for customers that don't have their own.
  defaultPriceListId      String?    @map("default_price_list_id") @db.Uuid
  defaultPriceList        PriceList? @relation(fields: [defaultPriceListId], references: [id], onDelete: Restrict)

  @@map("company_settings")
}

// ─── Document numbering ───────────────────────────────────────────

enum DocumentType {
  QUOTATION
  SALES_ORDER
  INVOICE
  RECEIPT
  CREDIT_NOTE
  DELIVERY_NOTE
  PURCHASE_ORDER
  GOODS_RECEIPT
  STOCK_ADJUSTMENT
  JOURNAL_ENTRY
  CUSTOMER
  SUPPLIER
  STOCK_TRANSFER
  STOCK_COUNT
  SUPPLIER_BILL
  SUPPLIER_PAYMENT
  STOCK_REVALUATION
}

/// Next number per document type. Incremented with a row lock inside the
/// transaction that posts the document, so numbers are never reused or skipped twice.
model DocumentSequence {
  documentType DocumentType @id @map("document_type")
  prefix       String
  nextNumber   Int          @default(1) @map("next_number")
  padding      Int          @default(6)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("document_sequences")
}

// ─── Audit log ────────────────────────────────────────────────────

/// Append-only. A database trigger rejects UPDATE and DELETE.
model AuditLog {
  id          BigInt   @id @default(autoincrement())
  occurredAt  DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)
  actorUserId String?  @map("actor_user_id") @db.Uuid
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  /// Human-readable actor: a user's email, "system", "whatsapp:owner", or "legacy:<name>".
  actorLabel  String   @map("actor_label")
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  summary     String?
  before      Json?
  after       Json?
  metadata    Json?
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")

  @@index([entityType, entityId])
  @@index([occurredAt])
  @@index([actorUserId])
  @@map("audit_log")
}

// ─── Legacy data staging ──────────────────────────────────────────

/// One uploaded CSV export from the previous system. Loading the same file twice is a no-op.
model LegacyImportBatch {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceFile   String      @map("source_file")
  fileSha256   String      @map("file_sha256")
  rowCount     Int         @map("row_count")
  columns      String[]
  importedAt   DateTime    @default(now()) @map("imported_at") @db.Timestamptz(3)
  importedById String?     @map("imported_by_id") @db.Uuid
  importedBy   User?       @relation(fields: [importedById], references: [id], onDelete: Restrict)
  rows         LegacyRow[]

  @@unique([sourceFile, fileSha256])
  @@map("legacy_import_batches")
}

/// One CSV row, stored exactly as exported. Nothing is interpreted here;
/// the Phase 3 import reads these rows, applies the owner's decisions and
/// creates real customers, products, invoices and payments.
model LegacyRow {
  id        BigInt            @id @default(autoincrement())
  batchId   String            @map("batch_id") @db.Uuid
  batch     LegacyImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  rowNumber Int               @map("row_number")
  data      Json

  @@unique([batchId, rowNumber])
  @@map("legacy_rows")
}

// ─── Shared enums (Phase 3) ───────────────────────────────────────

enum RecordStatus {
  ACTIVE
  INACTIVE
}

/// The three ways a product can be counted and sold. Stock is always stored in PIECE.
enum SellUnit {
  PIECE
  PACK
  CARTON
}

/// The rate for each category is set in Phase 5 (tax settings), not hard-coded.
enum TaxCategory {
  STANDARD
  ZERO_RATED
  EXEMPT
}

// ─── Catalogue and pricing ────────────────────────────────────────

/// One sellable product (one SKU). Quantities are stored in pieces;
/// packs and cartons are conversions defined here.
model Product {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sku            String       @unique
  barcode        String?      @unique
  name           String
  brand          String
  category       String
  unitsPerPack   Int          @map("units_per_pack")
  packsPerCarton Int          @map("packs_per_carton")
  /// Cost of one piece, excluding tax. Null until the real cost is known.
  costPrice      Decimal?     @map("cost_price") @db.Decimal(18, 2)
  taxCategory    TaxCategory  @default(STANDARD) @map("tax_category")
  /// Warn when stock across all warehouses falls to or below this many pieces.
  reorderLevel   Int          @default(0) @map("reorder_level")
  status         RecordStatus @default(ACTIVE)
  notes          String?
  version        Int          @default(1)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  prices          PriceListItem[]
  balances        StockBalance[]
  movements       StockMovement[]
  adjustmentLines StockAdjustmentLine[]
  transferLines   StockTransferLine[]
  countLines      StockCountLine[]
  salesLines      SalesDocumentLine[]
  reservations    StockReservation[]
  valuation       InventoryValuation?
  revaluations    StockRevaluation[]
  orderLines      PurchaseOrderLine[]
  receiptLines    GoodsReceiptLine[]

  @@index([status, name])
  @@map("products")
}

model PriceList {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code             String       @unique
  name             String
  /// True when prices already include tax (VeeJam's practice so far).
  pricesIncludeTax Boolean      @default(true) @map("prices_include_tax")
  status           RecordStatus @default(ACTIVE)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  items          PriceListItem[]
  customers      Customer[]
  defaultFor     CompanySettings[]
  salesDocuments SalesDocument[]

  @@map("price_lists")
}

/// The price of one product in one unit (piece, pack or carton) on one price list.
model PriceListItem {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  priceListId String    @map("price_list_id") @db.Uuid
  priceList   PriceList @relation(fields: [priceListId], references: [id], onDelete: Restrict)
  productId   String    @map("product_id") @db.Uuid
  product     Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  unit        SellUnit
  price       Decimal   @db.Decimal(18, 2)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById String?   @map("updated_by_id") @db.Uuid
  updatedBy   User?     @relation(fields: [updatedById], references: [id], onDelete: Restrict)

  @@unique([priceListId, productId, unit])
  @@index([productId])
  @@map("price_list_items")
}

// ─── Customers and suppliers ──────────────────────────────────────

enum CustomerType {
  RETAIL_SHOP
  WHOLESALER
  SUPERMARKET
  KIOSK
  DISTRIBUTOR
  INSTITUTION
  WALK_IN
  OTHER
}

model Customer {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Account number, e.g. CUS-000001. Assigned automatically.
  code             String          @unique
  name             String
  type             CustomerType    @default(RETAIL_SHOP)
  contactPerson    String?         @map("contact_person")
  /// Kenyan mobile or landline in international form, digits only (2547XXXXXXXX).
  phone            String?
  email            String?
  kraPin           String?         @unique @map("kra_pin")
  physicalAddress  String?         @map("physical_address")
  town             String?
  /// 0 means cash only: a new invoice can be posted only if nothing is owed. Checked when invoices are posted.
  creditLimit      Decimal         @default(0) @map("credit_limit") @db.Decimal(18, 2)
  paymentTermsDays Int             @default(0) @map("payment_terms_days")
  priceListId      String?         @map("price_list_id") @db.Uuid
  priceList        PriceList?      @relation(fields: [priceListId], references: [id], onDelete: Restrict)
  status           RecordStatus    @default(ACTIVE)
  notes            String?
  /// Names this customer had in the previous system, for matching old records.
  legacyNames      String[]        @map("legacy_names")
  version          Int             @default(1)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById      String?         @map("created_by_id") @db.Uuid
  createdBy        User?           @relation(fields: [createdById], references: [id], onDelete: Restrict)
  salesDocuments   SalesDocument[]
  payments         Payment[]
  journalLines     JournalLine[]

  @@index([status, name])
  @@index([phone])
  @@map("customers")
}

model Supplier {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code             String       @unique
  name             String
  contactPerson    String?      @map("contact_person")
  phone            String?
  email            String?
  kraPin           String?      @unique @map("kra_pin")
  physicalAddress  String?      @map("physical_address")
  paymentTermsDays Int          @default(0) @map("payment_terms_days")
  status           RecordStatus @default(ACTIVE)
  notes            String?
  version          Int          @default(1)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  purchaseOrders PurchaseOrder[]
  goodsReceipts  GoodsReceipt[]
  bills          SupplierBill[]
  payments       SupplierPayment[]

  @@index([status, name])
  @@map("suppliers")
}

// ─── Inventory ────────────────────────────────────────────────────

model Warehouse {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String       @unique
  name      String
  location  String?
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  balances       StockBalance[]
  movements      StockMovement[]
  adjustments    StockAdjustment[]
  transfersOut   StockTransfer[]    @relation("TransferFrom")
  transfersIn    StockTransfer[]    @relation("TransferTo")
  counts         StockCount[]
  salesDocuments SalesDocument[]
  reservations   StockReservation[]
  purchaseOrders PurchaseOrder[]
  goodsReceipts  GoodsReceipt[]

  @@map("warehouses")
}

/// Current pieces on hand per product per warehouse. Changed only together with
/// a StockMovement row, under a row lock. Can never go below zero.
model StockBalance {
  productId   String    @map("product_id") @db.Uuid
  product     Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouseId String    @map("warehouse_id") @db.Uuid
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  quantity    Int       @default(0)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([productId, warehouseId])
  @@index([warehouseId])
  @@map("stock_balances")
}

enum StockMovementType {
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  TRANSFER_OUT
  TRANSFER_IN
  COUNT_GAIN
  COUNT_LOSS
  SALE
  RETURN_IN
  PURCHASE_IN
}

/// The stock ledger. Append-only: a trigger rejects UPDATE and DELETE.
model StockMovement {
  id           BigInt            @id @default(autoincrement())
  occurredAt   DateTime          @default(now()) @map("occurred_at") @db.Timestamptz(3)
  productId    String            @map("product_id") @db.Uuid
  product      Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouseId  String            @map("warehouse_id") @db.Uuid
  warehouse    Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  type         StockMovementType
  /// Pieces; positive adds stock, negative removes it.
  quantity     Int
  balanceAfter Int               @map("balance_after")
  /// Cost of the pieces moved, KES excl. VAT, same sign as quantity. Null for transfers and movements before costing.
  costValue    Decimal?          @map("cost_value") @db.Decimal(18, 2)
  sourceType   String            @map("source_type")
  sourceId     String            @map("source_id") @db.Uuid
  sourceNumber String            @map("source_number")
  reason       String?
  createdById  String?           @map("created_by_id") @db.Uuid
  createdBy    User?             @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([productId, occurredAt])
  @@index([warehouseId, occurredAt])
  @@index([sourceType, sourceId])
  @@map("stock_movements")
}

enum AdjustmentReason {
  OPENING_BALANCE
  DAMAGED
  EXPIRED
  LOST_OR_STOLEN
  FOUND
  SAMPLE_OR_PROMOTION
  CORRECTION
  OTHER
}

model StockAdjustment {
  id             String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  number         String                @unique
  warehouseId    String                @map("warehouse_id") @db.Uuid
  warehouse      Warehouse             @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  reason         AdjustmentReason
  notes          String?
  /// Makes double-clicks and retries harmless: the same key never posts twice.
  idempotencyKey String                @unique @map("idempotency_key")
  postedAt       DateTime              @default(now()) @map("posted_at") @db.Timestamptz(3)
  postedById     String                @map("posted_by_id") @db.Uuid
  postedBy       User                  @relation(fields: [postedById], references: [id], onDelete: Restrict)
  lines          StockAdjustmentLine[]

  @@index([postedAt])
  @@map("stock_adjustments")
}

model StockAdjustmentLine {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adjustmentId String          @map("adjustment_id") @db.Uuid
  adjustment   StockAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Restrict)
  productId    String          @map("product_id") @db.Uuid
  product      Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  /// As entered: e.g. 2 CARTON.
  unit         SellUnit
  unitQuantity Int             @map("unit_quantity")
  /// Converted to pieces; positive adds, negative removes.
  quantity     Int

  @@index([adjustmentId])
  @@map("stock_adjustment_lines")
}

model StockTransfer {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  number          String              @unique
  fromWarehouseId String              @map("from_warehouse_id") @db.Uuid
  fromWarehouse   Warehouse           @relation("TransferFrom", fields: [fromWarehouseId], references: [id], onDelete: Restrict)
  toWarehouseId   String              @map("to_warehouse_id") @db.Uuid
  toWarehouse     Warehouse           @relation("TransferTo", fields: [toWarehouseId], references: [id], onDelete: Restrict)
  notes           String?
  idempotencyKey  String              @unique @map("idempotency_key")
  postedAt        DateTime            @default(now()) @map("posted_at") @db.Timestamptz(3)
  postedById      String              @map("posted_by_id") @db.Uuid
  postedBy        User                @relation(fields: [postedById], references: [id], onDelete: Restrict)
  lines           StockTransferLine[]

  @@index([postedAt])
  @@map("stock_transfers")
}

model StockTransferLine {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transferId   String        @map("transfer_id") @db.Uuid
  transfer     StockTransfer @relation(fields: [transferId], references: [id], onDelete: Restrict)
  productId    String        @map("product_id") @db.Uuid
  product      Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  unit         SellUnit
  unitQuantity Int           @map("unit_quantity")
  /// Pieces moved (always positive).
  quantity     Int

  @@index([transferId])
  @@map("stock_transfer_lines")
}

enum StockCountStatus {
  DRAFT
  POSTED
  CANCELLED
}

/// A physical stock count. Posting sets each counted product's balance to the
/// counted quantity, recording the difference as a gain or loss movement.
model StockCount {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  number      String           @unique
  warehouseId String           @map("warehouse_id") @db.Uuid
  warehouse   Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  status      StockCountStatus @default(DRAFT)
  notes       String?
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById String           @map("created_by_id") @db.Uuid
  createdBy   User             @relation("StockCountCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  postedAt    DateTime?        @map("posted_at") @db.Timestamptz(3)
  postedById  String?          @map("posted_by_id") @db.Uuid
  postedBy    User?            @relation("StockCountPostedBy", fields: [postedById], references: [id], onDelete: Restrict)
  cancelledAt DateTime?        @map("cancelled_at") @db.Timestamptz(3)
  version     Int              @default(1)
  lines       StockCountLine[]

  @@index([status, createdAt])
  @@map("stock_counts")
}

model StockCountLine {
  id                   String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  countId              String     @map("count_id") @db.Uuid
  count                StockCount @relation(fields: [countId], references: [id], onDelete: Restrict)
  productId            String     @map("product_id") @db.Uuid
  product              Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  /// Pieces the system showed when the count was started.
  expectedQuantity     Int        @map("expected_quantity")
  /// Pieces counted. Null = not counted yet (left unchanged when posting).
  countedQuantity      Int?       @map("counted_quantity")
  /// Pieces the system showed at the moment of posting; the variance is counted − this.
  systemQuantityAtPost Int?       @map("system_quantity_at_post")

  @@unique([countId, productId])
  @@map("stock_count_lines")
}

// ─── Imports (CSV) ────────────────────────────────────────────────

enum ImportKind {
  CUSTOMERS
  PRODUCTS
  SUPPLIERS
}

enum ImportJobStatus {
  VALIDATED
  COMMITTED
  CANCELLED
}

/// One uploaded CSV. It is validated first and shown for review; nothing is
/// written to customers/products until someone commits it, and then all rows
/// are written together or none are.
model ImportJob {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind          ImportKind
  fileName      String          @map("file_name")
  fileSha256    String          @map("file_sha256")
  status        ImportJobStatus @default(VALIDATED)
  totalRows     Int             @map("total_rows")
  errorRows     Int             @map("error_rows")
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById   String          @map("created_by_id") @db.Uuid
  createdBy     User            @relation("ImportJobCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  committedAt   DateTime?       @map("committed_at") @db.Timestamptz(3)
  committedById String?         @map("committed_by_id") @db.Uuid
  committedBy   User?           @relation("ImportJobCommittedBy", fields: [committedById], references: [id], onDelete: Restrict)
  summary       Json?
  rows          ImportJobRow[]

  @@index([createdAt])
  @@map("import_jobs")
}

model ImportJobRow {
  id        BigInt    @id @default(autoincrement())
  jobId     String    @map("job_id") @db.Uuid
  job       ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  rowNumber Int       @map("row_number")
  data      Json
  /// CREATE or UPDATE when valid; null when the row has errors.
  action    String?
  errors    String[]

  @@unique([jobId, rowNumber])
  @@map("import_job_rows")
}

// ─── Sales (Phase 4) ──────────────────────────────────────────────

/// Tax rate per tax category. Configuration, not code: confirm with the accountant.
model TaxRate {
  category    TaxCategory @id
  name        String
  /// Percentage, e.g. 16.0000 for 16%.
  rate        Decimal     @db.Decimal(9, 4)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById String?     @map("updated_by_id") @db.Uuid
  updatedBy   User?       @relation(fields: [updatedById], references: [id], onDelete: Restrict)

  @@map("tax_rates")
}

enum SalesDocumentKind {
  QUOTATION
  SALES_ORDER
  INVOICE
  CREDIT_NOTE
}

/// Which statuses each kind may use is enforced by a CHECK constraint.
/// Quotation: DRAFT → SENT → ACCEPTED/DECLINED → CONVERTED (or CANCELLED)
/// Sales order: DRAFT → CONFIRMED (stock reserved) → INVOICED (or CANCELLED)
/// Invoice: DRAFT → POSTED (numbered, stock deducted; can't be edited or deleted)
enum SalesDocumentStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  CONVERTED
  CONFIRMED
  INVOICED
  POSTED
  CANCELLED
}

/// Quotations, sales orders and invoices share one table and one set of
/// pricing/tax rules, so a quote can become an order and then an invoice
/// without re-keying anything.
model SalesDocument {
  id                   String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind                 SalesDocumentKind
  /// QUO-/SO- numbers are given at creation. INV- numbers only when an invoice is posted, so there are no gaps.
  number               String?             @unique
  status               SalesDocumentStatus @default(DRAFT)
  customerId           String              @map("customer_id") @db.Uuid
  customer             Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  /// Where the stock comes from.
  warehouseId          String              @map("warehouse_id") @db.Uuid
  warehouse            Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  priceListId          String?             @map("price_list_id") @db.Uuid
  priceList            PriceList?          @relation(fields: [priceListId], references: [id], onDelete: Restrict)
  pricesIncludeTax     Boolean             @default(true) @map("prices_include_tax")
  issueDate            DateTime            @map("issue_date") @db.Date
  validUntil           DateTime?           @map("valid_until") @db.Date
  dueDate              DateTime?           @map("due_date") @db.Date
  /// The customer's own order or LPO number.
  customerReference    String?             @map("customer_reference")
  notes                String?
  sourceDocumentId     String?             @map("source_document_id") @db.Uuid
  sourceDocument       SalesDocument?      @relation("SalesDocumentSource", fields: [sourceDocumentId], references: [id], onDelete: Restrict)
  derivedDocuments     SalesDocument[]     @relation("SalesDocumentSource")
  /// Totals excluding tax, discounts given, tax, and the amount payable. Recalculated on the server only.
  subtotal             Decimal             @default(0) @db.Decimal(18, 2)
  discountTotal        Decimal             @default(0) @map("discount_total") @db.Decimal(18, 2)
  taxTotal             Decimal             @default(0) @map("tax_total") @db.Decimal(18, 2)
  total                Decimal             @default(0) @db.Decimal(18, 2)
  /// Updated by payments from Phase 5.
  amountPaid           Decimal             @default(0) @map("amount_paid") @db.Decimal(18, 2)
  /// Brought across from the old system with its original VJL- number. Read-only; never moved stock here.
  historical           Boolean             @default(false)
  /// Invoices: total of credit notes applied to this invoice.
  amountCredited       Decimal             @default(0) @map("amount_credited") @db.Decimal(18, 2)
  /// Credit notes: the returned goods went back into stock.
  returnsToStock       Boolean             @default(false) @map("returns_to_stock")
  /// Credit notes: the form's key, so a double submit issues one credit note.
  idempotencyKey       String?             @unique @map("idempotency_key")
  /// Company and customer details frozen at posting, so reprints match the original.
  companySnapshot      Json?               @map("company_snapshot")
  customerSnapshot     Json?               @map("customer_snapshot")
  creditOverrideReason String?             @map("credit_override_reason")
  creditOverrideById   String?             @map("credit_override_by_id") @db.Uuid
  creditOverrideBy     User?               @relation("SalesDocumentCreditOverrideBy", fields: [creditOverrideById], references: [id], onDelete: Restrict)
  version              Int                 @default(1)
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById          String              @map("created_by_id") @db.Uuid
  createdBy            User                @relation("SalesDocumentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  confirmedAt          DateTime?           @map("confirmed_at") @db.Timestamptz(3)
  postedAt             DateTime?           @map("posted_at") @db.Timestamptz(3)
  postedById           String?             @map("posted_by_id") @db.Uuid
  postedBy             User?               @relation("SalesDocumentPostedBy", fields: [postedById], references: [id], onDelete: Restrict)
  cancelledAt          DateTime?           @map("cancelled_at") @db.Timestamptz(3)
  cancelReason         String?             @map("cancel_reason")

  lines               SalesDocumentLine[]
  reservations        StockReservation[]
  deliveryNote        DeliveryNote?
  shareLinks          DocumentShareLink[]
  allocationsReceived PaymentAllocation[] @relation("AllocationInvoice")
  allocationsGiven    PaymentAllocation[] @relation("AllocationCreditNote")

  @@index([kind, status, issueDate])
  @@index([customerId, kind, status])
  @@map("sales_documents")
}

/// One product line. Product details and the tax rate are copied in, so a
/// posted invoice never changes when a product or rate is edited later.
model SalesDocumentLine {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId      String        @map("document_id") @db.Uuid
  document        SalesDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  position        Int
  productId       String        @map("product_id") @db.Uuid
  product         Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  sku             String
  description     String
  unit            SellUnit
  /// Units as sold (e.g. 2 cartons) and the same quantity in pieces.
  quantity        Int
  piecesPerUnit   Int           @map("pieces_per_unit")
  pieces          Int
  unitPrice       Decimal       @map("unit_price") @db.Decimal(18, 2)
  discountPercent Decimal       @default(0) @map("discount_percent") @db.Decimal(5, 2)
  taxCategory     TaxCategory   @map("tax_category")
  taxRate         Decimal       @map("tax_rate") @db.Decimal(9, 4)
  netAmount       Decimal       @map("net_amount") @db.Decimal(18, 2)
  discountAmount  Decimal       @default(0) @map("discount_amount") @db.Decimal(18, 2)
  taxAmount       Decimal       @map("tax_amount") @db.Decimal(18, 2)
  grossAmount     Decimal       @map("gross_amount") @db.Decimal(18, 2)

  @@unique([documentId, position])
  @@index([productId])
  @@map("sales_document_lines")
}

/// Stock promised to a confirmed sales order. Released when the order is
/// invoiced or cancelled. Available stock = on hand − reserved.
model StockReservation {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId  String        @map("document_id") @db.Uuid
  document    SalesDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  productId   String        @map("product_id") @db.Uuid
  product     Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouseId String        @map("warehouse_id") @db.Uuid
  warehouse   Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  quantity    Int
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([documentId, productId, warehouseId])
  @@index([productId, warehouseId])
  @@map("stock_reservations")
}

enum DeliveryStatus {
  PREPARED
  DISPATCHED
  DELIVERED
  CANCELLED
}

/// Delivery note for a posted invoice (the whole invoice is delivered).
model DeliveryNote {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  number       String         @unique
  invoiceId    String         @unique @map("invoice_id") @db.Uuid
  invoice      SalesDocument  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  status       DeliveryStatus @default(PREPARED)
  vehicle      String?
  driver       String?
  notes        String?
  dispatchedAt DateTime?      @map("dispatched_at") @db.Timestamptz(3)
  deliveredAt  DateTime?      @map("delivered_at") @db.Timestamptz(3)
  receivedBy   String?        @map("received_by")
  version      Int            @default(1)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById  String         @map("created_by_id") @db.Uuid
  createdBy    User           @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@map("delivery_notes")
}

/// A link that lets someone without an account open one document's PDF.
/// Only a hash of the token is stored; links expire and can be revoked.
model DocumentShareLink {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId     String        @map("document_id") @db.Uuid
  document       SalesDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)
  tokenHash      String        @unique @map("token_hash")
  expiresAt      DateTime      @map("expires_at") @db.Timestamptz(3)
  revokedAt      DateTime?     @map("revoked_at") @db.Timestamptz(3)
  accessCount    Int           @default(0) @map("access_count")
  lastAccessedAt DateTime?     @map("last_accessed_at") @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById    String        @map("created_by_id") @db.Uuid
  createdBy      User          @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([documentId])
  @@map("document_share_links")
}

// ─── Money and accounting (Phase 5a) ─────────────────────────────

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

/// Chart of accounts. Accounts the system posts to automatically have a systemKey.
model Account {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String       @unique
  name      String
  type      AccountType
  /// e.g. AR, SALES, VAT_OUTPUT, CASH, MPESA, BANK. Never changes once set.
  systemKey String?      @unique @map("system_key")
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  lines     JournalLine[]
  billLines SupplierBillLine[]

  @@map("accounts")
}

/// A balanced journal entry (debits = credits, checked by the database). Append-only:
/// mistakes are corrected with a reversing entry.
model JournalEntry {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  number       String        @unique
  date         DateTime      @db.Date
  description  String
  /// What caused it: Invoice, Payment, CreditNote, PaymentReversal, OpeningBalances, Manual.
  sourceType   String        @map("source_type")
  sourceId     String?       @map("source_id") @db.Uuid
  sourceNumber String?       @map("source_number")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById  String        @map("created_by_id") @db.Uuid
  createdBy    User          @relation(fields: [createdById], references: [id], onDelete: Restrict)
  lines        JournalLine[]

  @@unique([sourceType, sourceId])
  @@index([date])
  @@map("journal_entries")
}

model JournalLine {
  id          BigInt       @id @default(autoincrement())
  entryId     String       @map("entry_id") @db.Uuid
  entry       JournalEntry @relation(fields: [entryId], references: [id], onDelete: Restrict)
  accountId   String       @map("account_id") @db.Uuid
  account     Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  debit       Decimal      @default(0) @db.Decimal(18, 2)
  credit      Decimal      @default(0) @db.Decimal(18, 2)
  /// Set on receivables lines, so a customer's account can be followed in the ledger.
  customerId  String?      @map("customer_id") @db.Uuid
  customer    Customer?    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  description String?

  @@index([entryId])
  @@index([accountId])
  @@index([customerId])
  @@map("journal_lines")
}

enum PaymentMethod {
  CASH
  MPESA
  BANK_TRANSFER
  CHEQUE
}

enum PaymentStatus {
  POSTED
  REVERSED
}

/// Money received from a customer (RCT- receipt). Applied to invoices through allocations;
/// any part not applied is credit on the customer's account.
model Payment {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  number         String              @unique
  customerId     String              @map("customer_id") @db.Uuid
  customer       Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  receivedOn     DateTime            @map("received_on") @db.Date
  method         PaymentMethod
  /// M-Pesa code, bank reference or cheque number. The same reference can't be recorded twice for one method.
  reference      String?
  amount         Decimal             @db.Decimal(18, 2)
  notes          String?
  status         PaymentStatus       @default(POSTED)
  idempotencyKey String              @unique @map("idempotency_key")
  receivedById   String              @map("received_by_id") @db.Uuid
  receivedBy     User                @relation("PaymentReceivedBy", fields: [receivedById], references: [id], onDelete: Restrict)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  reversedAt     DateTime?           @map("reversed_at") @db.Timestamptz(3)
  reversedById   String?             @map("reversed_by_id") @db.Uuid
  reversedBy     User?               @relation("PaymentReversedBy", fields: [reversedById], references: [id], onDelete: Restrict)
  reverseReason  String?             @map("reverse_reason")
  version        Int                 @default(1)
  allocations    PaymentAllocation[]

  @@unique([method, reference])
  @@index([customerId, receivedOn])
  @@map("payments")
}

/// Part of a payment or credit note applied to one invoice.
model PaymentAllocation {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId    String         @map("invoice_id") @db.Uuid
  invoice      SalesDocument  @relation("AllocationInvoice", fields: [invoiceId], references: [id], onDelete: Restrict)
  paymentId    String?        @map("payment_id") @db.Uuid
  payment      Payment?       @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  creditNoteId String?        @map("credit_note_id") @db.Uuid
  creditNote   SalesDocument? @relation("AllocationCreditNote", fields: [creditNoteId], references: [id], onDelete: Restrict)
  amount       Decimal        @db.Decimal(18, 2)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById  String         @map("created_by_id") @db.Uuid
  createdBy    User           @relation(fields: [createdById], references: [id], onDelete: Restrict)
  /// Set when the payment is reversed; the allocation then no longer counts.
  reversedAt   DateTime?      @map("reversed_at") @db.Timestamptz(3)

  @@index([invoiceId])
  @@index([paymentId])
  @@index([creditNoteId])
  @@map("payment_allocations")
}

// ─── Phase 6: WhatsApp ─────────────────────────────────────────────

enum WhatsAppDirection {
  IN
  OUT
}

enum WhatsAppMessageStatus {
  RECEIVED
  PROCESSED
  REFUSED
  FAILED
  SENT
  SIMULATED
}

/// Every WhatsApp message in or out. Incoming messages are unique by the
/// provider's message id, so a webhook delivered twice is processed once.
model WhatsAppMessage {
  id                String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  direction         WhatsAppDirection
  waNumber          String                @map("wa_number")
  body              String
  providerMessageId String?               @unique @map("provider_message_id")
  status            WhatsAppMessageStatus
  /// The command recognised in an incoming message, e.g. "SALES" or "PAY".
  command           String?
  userId            String?               @map("user_id") @db.Uuid
  user              User?                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  simulated         Boolean               @default(false)
  error             String?
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([waNumber, createdAt])
  @@index([createdAt])
  @@map("whatsapp_messages")
}

enum WhatsAppConfirmationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
  FAILED
}

/// A change requested on WhatsApp, waiting for the owner to reply YES with the code.
/// Single use, expires after a few minutes, bound to the owner and the draft it describes.
model WhatsAppConfirmation {
  id         String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String                     @map("user_id") @db.Uuid
  user       User                       @relation(fields: [userId], references: [id], onDelete: Restrict)
  waNumber   String                     @map("wa_number")
  action     String
  payload    Json
  summary    String
  /// SHA-256 of the code; the code itself is only ever in the message.
  codeHash   String                     @map("code_hash")
  attempts   Int                        @default(0)
  status     WhatsAppConfirmationStatus @default(PENDING)
  expiresAt  DateTime                   @map("expires_at") @db.Timestamptz(3)
  resolvedAt DateTime?                  @map("resolved_at") @db.Timestamptz(3)
  resultRef  String?                    @map("result_ref")
  error      String?
  createdAt  DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId, status])
  @@map("whatsapp_confirmations")
}

// ─── Phase 8: hardening and backups ────────────────────────────────

/// Fixed-window request counters (sign-in failures, webhook, share links).
/// Kept in the database because serverless instances don't share memory.
model RateLimit {
  key         String
  windowStart DateTime @map("window_start") @db.Timestamptz(3)
  count       Int      @default(0)

  @@id([key, windowStart])
  @@index([windowStart])
  @@map("rate_limits")
}

/// One row per backup taken with `npm run backup`, so the app can warn when backups are overdue.
model BackupRun {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  takenAt  DateTime @default(now()) @map("taken_at") @db.Timestamptz(3)
  takenBy  String   @map("taken_by")
  fileName String   @map("file_name")
  tables   Int
  rows     Int
  bytes    Int
  sha256   String
  /// "backup" or "restore-drill".
  kind     String   @default("backup")

  @@index([takenAt])
  @@map("backup_runs")
}

// ─── Phase 5b: purchasing, payables and stock costing ─────────────────

/// Running total cost of each product's stock (all warehouses), for weighted-average costing.
/// Kept in step with stock_balances by applyStockChanges, under the same locks.
model InventoryValuation {
  productId String   @id @map("product_id") @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  /// Pieces on hand across all warehouses.
  quantity  Int      @default(0)
  /// What those pieces cost, KES excl. VAT. Average cost per piece = value ÷ quantity.
  value     Decimal  @default(0) @db.Decimal(18, 2)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("inventory_valuations")
}

/// Setting what stock on hand is worth, e.g. the opening cost of stock brought from the old system.
model StockRevaluation {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  number         String   @unique
  productId      String   @map("product_id") @db.Uuid
  product        Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity       Int
  oldValue       Decimal  @map("old_value") @db.Decimal(18, 2)
  newValue       Decimal  @map("new_value") @db.Decimal(18, 2)
  /// True: the difference goes to Opening balances (setting up). False: to Stock gains and losses.
  againstOpening Boolean  @map("against_opening")
  reason         String
  createdById    String   @map("created_by_id") @db.Uuid
  createdBy      User     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([productId, createdAt])
  @@map("stock_revaluations")
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTLY_RECEIVED
  RECEIVED
  CLOSED
  CANCELLED
}

model PurchaseOrder {
  id           String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  number       String              @unique
  status       PurchaseOrderStatus @default(DRAFT)
  supplierId   String              @map("supplier_id") @db.Uuid
  supplier     Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  /// Where the goods will be delivered.
  warehouseId  String              @map("warehouse_id") @db.Uuid
  warehouse    Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  orderDate    DateTime            @map("order_date") @db.Date
  expectedDate DateTime?           @map("expected_date") @db.Date
  notes        String?
  /// Totals excluding VAT, VAT and total. Worked out on the server only.
  subtotal     Decimal             @default(0) @db.Decimal(18, 2)
  taxTotal     Decimal             @default(0) @map("tax_total") @db.Decimal(18, 2)
  total        Decimal             @default(0) @db.Decimal(18, 2)
  version      Int                 @default(1)
  createdById  String              @map("created_by_id") @db.Uuid
  createdBy    User                @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  orderedAt    DateTime?           @map("ordered_at") @db.Timestamptz(3)
  closedAt     DateTime?           @map("closed_at") @db.Timestamptz(3)
  cancelledAt  DateTime?           @map("cancelled_at") @db.Timestamptz(3)
  cancelReason String?             @map("cancel_reason")

  lines    PurchaseOrderLine[]
  receipts GoodsReceipt[]

  @@index([status, orderDate])
  @@index([supplierId, status])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId        String        @map("order_id") @db.Uuid
  order          PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  position       Int
  productId      String        @map("product_id") @db.Uuid
  product        Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  sku            String
  description    String
  unit           SellUnit
  quantity       Int
  piecesPerUnit  Int           @map("pieces_per_unit")
  pieces         Int
  /// Cost of one unit (e.g. one carton), excluding VAT.
  unitCost       Decimal       @map("unit_cost") @db.Decimal(18, 2)
  taxRate        Decimal       @map("tax_rate") @db.Decimal(9, 4)
  netAmount      Decimal       @map("net_amount") @db.Decimal(18, 2)
  taxAmount      Decimal       @map("tax_amount") @db.Decimal(18, 2)
  grossAmount    Decimal       @map("gross_amount") @db.Decimal(18, 2)
  receivedPieces Int           @default(0) @map("received_pieces")

  receiptLines GoodsReceiptLine[]

  @@unique([orderId, position])
  @@index([productId])
  @@map("purchase_order_lines")
}

/// Goods received (GRN-). Posting puts the stock in at cost. Immutable once posted.
model GoodsReceipt {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  number            String         @unique
  supplierId        String         @map("supplier_id") @db.Uuid
  supplier          Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  warehouseId       String         @map("warehouse_id") @db.Uuid
  warehouse         Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  purchaseOrderId   String?        @map("purchase_order_id") @db.Uuid
  purchaseOrder     PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  receivedOn        DateTime       @map("received_on") @db.Date
  /// The supplier's delivery note or invoice number.
  supplierReference String?        @map("supplier_reference")
  notes             String?
  /// Cost of everything received, excluding VAT.
  totalCost         Decimal        @map("total_cost") @db.Decimal(18, 2)
  /// VAT the supplier is expected to charge on it (a default for the bill).
  expectedTax       Decimal        @default(0) @map("expected_tax") @db.Decimal(18, 2)
  /// Set when the supplier's bill for these goods is entered.
  billId            String?        @map("bill_id") @db.Uuid
  bill              SupplierBill?  @relation(fields: [billId], references: [id], onDelete: Restrict)
  idempotencyKey    String         @unique @map("idempotency_key")
  postedById        String         @map("posted_by_id") @db.Uuid
  postedBy          User           @relation(fields: [postedById], references: [id], onDelete: Restrict)
  postedAt          DateTime       @default(now()) @map("posted_at") @db.Timestamptz(3)

  lines     GoodsReceiptLine[]
  billLines SupplierBillLine[]

  @@index([supplierId, billId])
  @@index([receivedOn])
  @@map("goods_receipts")
}

model GoodsReceiptLine {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  receiptId   String             @map("receipt_id") @db.Uuid
  receipt     GoodsReceipt       @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  productId   String             @map("product_id") @db.Uuid
  product     Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  orderLineId String?            @map("order_line_id") @db.Uuid
  orderLine   PurchaseOrderLine? @relation(fields: [orderLineId], references: [id], onDelete: Restrict)
  unit        SellUnit
  quantity    Int
  pieces      Int
  /// Cost of one unit as received, excluding VAT.
  unitCost    Decimal            @map("unit_cost") @db.Decimal(18, 2)
  lineCost    Decimal            @map("line_cost") @db.Decimal(18, 2)
  taxRate     Decimal            @map("tax_rate") @db.Decimal(9, 4)

  @@index([receiptId])
  @@index([productId])
  @@map("goods_receipt_lines")
}

enum SupplierBillStatus {
  POSTED
  CANCELLED
}

enum BillLineKind {
  GOODS
  EXPENSE
}

/// A supplier's invoice (BILL-), entered when it arrives. Immutable once posted; cancelled only while unpaid.
model SupplierBill {
  id                    String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  number                String             @unique
  supplierId            String             @map("supplier_id") @db.Uuid
  supplier              Supplier           @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  /// The number printed on the supplier's invoice.
  supplierInvoiceNumber String             @map("supplier_invoice_number")
  billDate              DateTime           @map("bill_date") @db.Date
  dueDate               DateTime           @map("due_date") @db.Date
  subtotal              Decimal            @db.Decimal(18, 2)
  taxTotal              Decimal            @map("tax_total") @db.Decimal(18, 2)
  total                 Decimal            @db.Decimal(18, 2)
  amountPaid            Decimal            @default(0) @map("amount_paid") @db.Decimal(18, 2)
  status                SupplierBillStatus @default(POSTED)
  notes                 String?
  idempotencyKey        String             @unique @map("idempotency_key")
  postedById            String             @map("posted_by_id") @db.Uuid
  postedBy              User               @relation("SupplierBillPostedBy", fields: [postedById], references: [id], onDelete: Restrict)
  postedAt              DateTime           @default(now()) @map("posted_at") @db.Timestamptz(3)
  cancelledAt           DateTime?          @map("cancelled_at") @db.Timestamptz(3)
  cancelledById         String?            @map("cancelled_by_id") @db.Uuid
  cancelledBy           User?              @relation("SupplierBillCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  cancelReason          String?            @map("cancel_reason")
  version               Int                @default(1)

  lines       SupplierBillLine[]
  receipts    GoodsReceipt[]
  allocations SupplierPaymentAllocation[]

  @@index([supplierId, status])
  @@index([dueDate])
  @@map("supplier_bills")
}

model SupplierBillLine {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  billId         String        @map("bill_id") @db.Uuid
  bill           SupplierBill  @relation(fields: [billId], references: [id], onDelete: Restrict)
  position       Int
  kind           BillLineKind
  goodsReceiptId String?       @map("goods_receipt_id") @db.Uuid
  goodsReceipt   GoodsReceipt? @relation(fields: [goodsReceiptId], references: [id], onDelete: Restrict)
  accountId      String?       @map("account_id") @db.Uuid
  account        Account?      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  description    String
  netAmount      Decimal       @map("net_amount") @db.Decimal(18, 2)
  taxAmount      Decimal       @map("tax_amount") @db.Decimal(18, 2)
  grossAmount    Decimal       @map("gross_amount") @db.Decimal(18, 2)

  @@unique([billId, position])
  @@index([goodsReceiptId])
  @@map("supplier_bill_lines")
}

/// Money paid to a supplier (SPAY-). Mistakes are reversed, never deleted.
model SupplierPayment {
  id             String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  number         String                      @unique
  supplierId     String                      @map("supplier_id") @db.Uuid
  supplier       Supplier                    @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  paidOn         DateTime                    @map("paid_on") @db.Date
  method         PaymentMethod
  reference      String?
  amount         Decimal                     @db.Decimal(18, 2)
  notes          String?
  status         PaymentStatus               @default(POSTED)
  idempotencyKey String                      @unique @map("idempotency_key")
  paidById       String                      @map("paid_by_id") @db.Uuid
  paidBy         User                        @relation("SupplierPaymentPaidBy", fields: [paidById], references: [id], onDelete: Restrict)
  createdAt      DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  reversedAt     DateTime?                   @map("reversed_at") @db.Timestamptz(3)
  reversedById   String?                     @map("reversed_by_id") @db.Uuid
  reversedBy     User?                       @relation("SupplierPaymentReversedBy", fields: [reversedById], references: [id], onDelete: Restrict)
  reverseReason  String?                     @map("reverse_reason")
  version        Int                         @default(1)
  allocations    SupplierPaymentAllocation[]

  @@index([supplierId, paidOn])
  @@map("supplier_payments")
}

model SupplierPaymentAllocation {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId  String          @map("payment_id") @db.Uuid
  payment    SupplierPayment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  billId     String          @map("bill_id") @db.Uuid
  bill       SupplierBill    @relation(fields: [billId], references: [id], onDelete: Restrict)
  amount     Decimal         @db.Decimal(18, 2)
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  reversedAt DateTime?       @map("reversed_at") @db.Timestamptz(3)

  @@index([paymentId])
  @@index([billId])
  @@map("supplier_payment_allocations")
}
