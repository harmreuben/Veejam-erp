# VeeJam ERP environment template
# ------------------------------------------------------------------
# Copy this file to .env.local (PowerShell: Copy-Item .env.example .env.local)
# and fill in values as each phase needs them. .env.local is ignored by Git.
# NEVER put real secrets in this file or commit them anywhere.
#
# Variables starting with NEXT_PUBLIC_ are sent to the browser. Only the
# Supabase URL and the anon/publishable key may use that prefix.

# --- App -----------------------------------------------------------
# Where the app is reachable. Local: http://localhost:3000. Production: your Vercel URL.
APP_BASE_URL=http://localhost:3000

# --- Database: Supabase Postgres (Phase 2) -------------------------
# Supabase dashboard > Project > Connect > ORMs > Prisma.
# DATABASE_URL = pooled connection (port 6543, ?pgbouncer=true) used by the app.
# DIRECT_URL   = direct connection (port 5432) used by Prisma migrations.
DATABASE_URL=
DIRECT_URL=

# --- Supabase Auth (Phase 2) ---------------------------------------
# Supabase dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Full database access, bypasses row-level security. Never expose.
SUPABASE_SERVICE_ROLE_KEY=

# --- WhatsApp (Phases 6-7) -----------------------------------------
# mock = simulated messages, no Meta account needed (default)
# meta = official WhatsApp Business Platform Cloud API
WHATSAPP_PROVIDER=mock

# The ONLY number allowed to run ERP commands. Digits only, country code first,
# no plus sign or spaces, e.g. 254712345678
VEEJAM_OWNER_WHATSAPP_NUMBER=

# Meta for Developers > your app > WhatsApp > API Setup (Phase 7)
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
# A random string YOU choose; enter the same value in Meta's webhook settings.
META_WHATSAPP_VERIFY_TOKEN=
# Meta for Developers > your app > App settings > Basic > App secret.
META_APP_SECRET=
