# VeeJam ERP environment template
# ------------------------------------------------------------------
# Copy this file to .env.local (PowerShell: Copy-Item .env.example .env.local)
# and fill in values as each phase needs them. .env.local is ignored by Git.
# NEVER put real secrets in this file or commit them anywhere.
#
# Variables starting with NEXT_PUBLIC_ are allowed in browser code. Only the
# Supabase URL and the publishable (anon) key may use that prefix.

# --- App -----------------------------------------------------------
# Where the app is reachable. Local: http://localhost:3000. Production: your Vercel URL.
APP_BASE_URL=http://localhost:3000

# --- Database: Supabase Postgres (Phase 2) -------------------------
# Supabase dashboard > your project > Connect (top bar).
# DATABASE_URL = "Transaction pooler" string (port 6543). Used by the running app.
# DIRECT_URL   = "Session pooler" string (port 5432). Used by migrations.
#                (The "Direct connection" needs IPv6, which many networks lack; the session pooler works everywhere.)
# Replace [YOUR-PASSWORD] with the database password you chose when creating the project.
DATABASE_URL=
DIRECT_URL=

# --- Supabase Auth (Phase 2) ---------------------------------------
# Supabase dashboard > Project Settings > API Keys.
NEXT_PUBLIC_SUPABASE_URL=
# The "publishable" key (sb_publishable_...) or, on older projects, the "anon" key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. The "secret" key (sb_secret_...) or older "service_role" key.
# Full access to your project: never share it, never put it in browser code.
SUPABASE_SERVICE_ROLE_KEY=

# --- Tests (optional) ----------------------------------------------
# Disposable local Postgres databases for npm run test:db and npm run test:e2e.
# They are WIPED on every test run. Their names must contain "test".
# See docs/TESTING.md for installing PostgreSQL on Windows.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/veejam_test
E2E_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/veejam_e2e_test

# --- WhatsApp (Phases 6-7) -----------------------------------------
# mock = simulated messages, no Meta account needed (default)
# meta = official WhatsApp Business Platform Cloud API
WHATSAPP_PROVIDER=mock

# The ONLY number allowed to run ERP commands. Digits only, country code first,
# no plus sign or spaces, e.g. 254712345678
VEEJAM_OWNER_WHATSAPP_NUMBER=

# Meta for Developers > your app > WhatsApp > API Setup (Phase 7)
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
# A random string YOU choose; enter the same value in Meta's webhook settings.
META_WHATSAPP_VERIFY_TOKEN=
# Meta for Developers > your app > App settings > Basic > App secret.
META_APP_SECRET=
